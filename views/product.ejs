<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= product.title %> - LapakBekas.id</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-black min-h-screen text-white flex flex-col justify-between">
    
    <!-- HEADER FULL SCREEN -->
    <div class="p-4 flex justify-between items-center bg-black/60 backdrop-blur-md sticky top-0 z-30 border-b border-white/10">
        <span class="text-xs font-bold text-gray-300 truncate max-w-[200px]"><%= product.title %></span>
        <a href="/" class="bg-white/10 hover:bg-white/20 text-white px-4 py-1.5 rounded-full text-xs font-bold transition">Kembali</a>
    </div>

    <!-- AREA SLIDER FOTO PRODUK -->
    <div class="flex-1 flex flex-col justify-center items-center relative overflow-hidden px-2 my-auto">
        <div id="sliderContainer" class="w-full max-w-lg flex overflow-x-auto snap-x snap-mandatory scrollbar-none space-x-4 px-4 py-2" style="scroll-snap-type: x mandatory;">
            <% if (product.images && product.images.length > 0) { %>
                <% product.images.forEach((img, index) => { %>
                    <div class="min-w-full flex justify-center items-center snap-center">
                        <img src="<%= img %>" onclick="openFullscreenModal(this.src)" class="max-h-[60vh] w-auto max-w-full rounded-2xl object-contain shadow-2xl border border-white/10 cursor-zoom-in" alt="Foto Produk">
                    </div>
                <% }) %>
            <% } else { %>
                <div class="min-w-full flex justify-center items-center snap-center">
                    <img src="<%= product.image %>" onclick="openFullscreenModal(this.src)" class="max-h-[60vh] w-auto max-w-full rounded-2xl object-contain shadow-2xl border border-white/10 cursor-zoom-in" alt="Foto Produk">
                </div>
            <% } %>
        </div>

        <!-- Indikator Slide -->
        <div class="flex space-x-1.5 mt-3">
            <% 
               let totalImages = (product.images && product.images.length > 0) ? product.images.length : 1;
            %>
            <% for(let i = 0; i < totalImages; i++) { %>
                <span class="w-2 h-2 rounded-full bg-white/40"></span>
            <% } %>
        </div>
        <p class="text-[10px] text-gray-400 mt-2">Geser foto untuk melihat detail lainnya (Ketuk foto untuk memperbesar)</p>
    </div>

    <!-- DETAIL INFORMASI PRODUK & TOMBOL WHATSAPP -->
    <div class="bg-neutral-900 rounded-t-3xl p-6 space-y-4 border-t border-white/10 z-20">
        <div class="flex justify-between items-start">
            <div>
                <span class="bg-emerald-500/20 text-emerald-400 text-[10px] font-bold px-2.5 py-1 rounded-full"><%= product.category %></span>
                <h1 class="font-black text-white text-base mt-2"><%= product.title %></h1>
            </div>
            <p class="font-black text-emerald-400 text-base">Rp <%= Number(product.price).toLocaleString('id-ID') %></p>
        </div>

        <div class="grid grid-cols-2 gap-2 text-xs text-neutral-300 bg-neutral-800/60 p-3 rounded-2xl border border-white/5">
            <div>Kondisi: <strong class="text-white"><%= product.condition %> (<%= product.damage_percent %>)</strong></div>
            <div>Lokasi: <strong class="text-white"><%= product.location %></strong></div>
        </div>

        <div>
            <h3 class="text-xs font-bold text-neutral-400 mb-1">Deskripsi Produk:</h3>
            <p class="text-xs text-neutral-200 whitespace-pre-line leading-relaxed bg-neutral-800/40 p-3 rounded-2xl border border-white/5"><%= product.description || 'Tidak ada deskripsi.' %></p>
        </div>

        <div class="pt-2">
            <a href="https://wa.me/<%= product.whatsapp %>?text=Halo%2C%20saya%20tertarik%20dengan%20produk%20<%= encodeURIComponent(product.title) %>" target="_blank" class="block w-full bg-emerald-600 hover:bg-emerald-500 text-white text-center font-bold py-3.5 rounded-2xl text-xs transition shadow-lg">
                Hubungi Penjual via WhatsApp
            </a>
        </div>
    </div>

    <!-- MODAL ZOOM FOTO FULLSCREEN -->
    <div id="zoomModal" class="fixed inset-0 bg-black/95 z-50 hidden flex flex-col justify-center items-center p-4">
        <button onclick="closeFullscreenModal()" class="absolute top-4 right-4 bg-white/20 hover:bg-white/30 text-white w-10 h-10 rounded-full font-bold text-sm flex items-center justify-center">✕</button>
        <img id="zoomImage" class="max-h-[90vh] max-w-[95vw] object-contain rounded-xl shadow-2xl">
    </div>

    <script>
        function openFullscreenModal(src) {
            const modal = document.getElementById('zoomModal');
            const img = document.getElementById('zoomImage');
            img.src = src;
            modal.classList.remove('hidden');
        }

        function closeFullscreenModal() {
            const modal = document.getElementById('zoomModal');
            modal.classList.add('hidden');
        }
    </script>
</body>
</html>
