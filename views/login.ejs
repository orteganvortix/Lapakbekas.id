<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Masuk - LAPAKBEKAS.ID</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-slate-50 text-slate-800 flex flex-col min-h-screen justify-center items-center p-4">
    <div class="max-w-md w-full bg-white rounded-2xl border p-8 shadow-sm text-center">
        <a href="/" class="text-2xl font-black tracking-wider text-emerald-600 block mb-2">
            LAPAK<span class="text-amber-500">BEKAS</span>.ID
        </a>
        <p class="text-slate-500 text-xs mb-6">Pilih metode masuk untuk mengelola iklan dan profil Anda.</p>

        <div class="space-y-3">
            <form action="/login" method="POST">
                <input type="hidden" name="provider" value="google">
                <input type="hidden" name="email" value="user.google@gmail.com">
                <input type="hidden" name="name" value="Pengguna Google">
                <button type="submit" class="w-full bg-white hover:bg-slate-50 border border-slate-300 text-slate-700 font-bold py-3 rounded-xl text-xs transition shadow-sm flex items-center justify-center gap-2">
                    <i class="fa-brands fa-google text-rose-500 text-base"></i> Masuk dengan Google (Auto PP Gmail)
                </button>
            </form>

            <form action="/login" method="POST">
                <input type="hidden" name="provider" value="facebook">
                <input type="hidden" name="email" value="user.fb@facebook.com">
                <input type="hidden" name="name" value="Pengguna Facebook">
                <button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 rounded-xl text-xs transition shadow-sm flex items-center justify-center gap-2">
                    <i class="fa-brands fa-facebook text-base"></i> Masuk dengan Facebook (Auto PP FB)
                </button>
            </form>
        </div>

        <div class="mt-6 pt-4 border-t">
            <a href="/" class="text-xs text-slate-400 hover:text-slate-600"><i class="fa-solid fa-arrow-left"></i> Kembali ke Beranda</a>
        </div>
    </div>
</body>
</html>
