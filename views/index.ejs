<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LapakBekas.id</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 min-h-screen flex flex-col">
    <nav class="bg-emerald-800 text-white sticky top-0 z-50 shadow-sm">
        <div class="max-w-md mx-auto px-4 py-3 flex justify-between items-center">
            <a href="/" class="text-lg font-black tracking-wider">LAPAKBEKAS<span class="text-emerald-400">.ID</span></a>
            <div class="flex items-center gap-2">
                <% if (user) { %>
                    <a href="/profile" class="bg-emerald-700 hover:bg-emerald-600 text-white px-3 py-1.5 rounded-xl font-bold text-xs flex items-center gap-1.5 transition">Profil</a>
                <% } else { %>
                    <a href="/login" class="bg-emerald-700 hover:bg-emerald-600 text-white px-3 py-1.5 rounded-xl font-bold text-xs transition">Masuk</a>
                <% } %>
                <a href="/sell" class="bg-amber-400 hover:bg-amber-500 text-emerald-950 px-3 py-1.5 rounded-xl font-black text-xs shadow-sm transition">+ Jual</a>
            </div>
        </div>
    </nav>

    <div class="bg-emerald-800 px-4 pt-4 pb-6">
        <div class="max-w-md mx-auto">
            <div class="bg-gradient-to-br from-emerald-500 to-emerald-700 rounded-3xl p-5 text-white shadow-lg space-y-4">
                <div class="space-y-1">
                    <h1 class="text-xl font-black tracking-tight">Cari Barang Bekas Sekitar Anda</h1>
                    <p class="text-xs text-emerald-100">Rekomendasi barang layak pakai langsung dari wilayah terdekat.</p>
                </div>

                <form action="/" method="GET" class="space-y-3">
                    <input type="text" name="search" value="<%= search %>" placeholder="Cari barang (misal: Vario, HP, TV)..." class="w-full bg-white text-gray-800 text-xs rounded-xl px-4 py-3 font-medium focus:outline-none shadow-sm">

                    <!-- Pilihan Kategori -->
                    <select name="category" id="categorySelect" onchange="updateBrands()" class="w-full bg-white text-gray-800 text-xs rounded-xl px-4 py-3 font-medium focus:outline-none shadow-sm">
                        <option value="Semua" <%= selectedCategory === 'Semua' ? 'selected' : '' %>>Semua Kategori</option>
                        <option value="Elektronik & Gadget" <%= selectedCategory === 'Elektronik & Gadget' ? 'selected' : '' %>>Elektronik & Gadget</option>
                        <option value="Kendaraan" <%= selectedCategory === 'Kendaraan' ? 'selected' : '' %>>Kendaraan</option>
                        <option value="Perabotan Rumah" <%= selectedCategory === 'Perabotan Rumah' ? 'selected' : '' %>>Perabotan Rumah</option>
                        <option value="Hobi & Lainnya" <%= selectedCategory === 'Hobi & Lainnya' ? 'selected' : '' %>>Hobi & Lainnya</option>
                    </select>

                    <!-- Pilihan Merk / Type (Sesuai Permintaan: Setelah jenis barang sebelum terapkan filter) -->
                    <select name="brand" id="brandSelect" class="w-full bg-white text-gray-800 text-xs rounded-xl px-4 py-3 font-medium focus:outline-none shadow-sm">
                        <option value="Semua">Semua Merk / Type</option>
                    </select>

                    <div class="flex gap-2">
                        <select name="location" class="w-full bg-white text-gray-800 text-xs rounded-xl px-4 py-3 font-medium focus:outline-none shadow-sm">
                            <option value="Semua" <%= selectedLocation === 'Semua' ? 'selected' : '' %>>Semua Wilayah / Kecamatan</option>
                            <% locations.forEach(loc => { %>
                                <option value="<%= loc %>" <%= selectedLocation === loc ? 'selected' : '' %>><%= loc %></option>
                            <% }) %>
                        </select>
                    </div>

                    <button type="submit" class="w-full bg-[#0d1b2a] hover:bg-[#1b263b] text-white font-bold py-3 rounded-xl text-xs transition shadow-md">Terapkan Filter</button>
                </form>
            </div>
        </div>
    </div>

    <main class="max-w-md mx-auto px-4 py-6 flex-1 w-full space-y-4">
        <div class="flex justify-between items-center">
            <h2 class="text-xs font-black uppercase tracking-wider text-gray-700">Rekomendasi Barang Tersedia</h2>
            <span class="bg-gray-200 text-gray-700 text-[10px] font-bold px-2 py-0.5 rounded-full"><%= products.length %> barang</span>
        </div>

        <% if (products.length === 0) { %>
            <div class="bg-white rounded-3xl border border-gray-100 p-8 text-center shadow-sm space-y-4">
                <p class="text-xs font-bold text-gray-600">Tidak ada barang di wilayah ini.</p>
                <a href="/" class="inline-block bg-[#0d1b2a] text-white font-bold px-6 py-2.5 rounded-xl text-xs">Reset Filter</a>
            </div>
        <% } else { %>
            <div class="grid grid-cols-2 gap-3">
                <% products.forEach(product => { %>
                    <a href="/product/<%= product.id %>" class="bg-white rounded-2xl border border-gray-100 overflow-hidden shadow-sm hover:shadow-md transition flex flex-col">
                        <img src="<%= product.image || (product.images && product.images[0]) %>" alt="<%= product.title %>" class="w-full h-36 object-cover">
                        <div class="p-3 flex flex-col flex-1 justify-between space-y-2">
                            <div>
                                <span class="text-[9px] font-bold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-md"><%= product.brand %></span>
                                <h3 class="font-bold text-gray-800 text-xs mt-1.5 line-clamp-2"><%= product.title %></h3>
                            </div>
                            <div>
                                <p class="text-emerald-700 font-black text-xs">Rp <%= Number(product.price).toLocaleString('id-ID') %></p>
                                <span class="text-[10px] text-gray-400 block truncate mt-1"><%= product.location %></span>
                            </div>
                        </div>
                    </a>
                <% }) %>
            </div>
        <% } %>
    </main>

    <script>
        const brandsMap = <%- JSON.stringify(brandsMap) %>;
        const selectedBrand = "<%= selectedBrand %>";

        function updateBrands() {
            const cat = document.getElementById('categorySelect').value;
            const brandSel = document.getElementById('brandSelect');
            brandSel.innerHTML = '<option value="Semua">Semua Merk / Type</option>';
            if (brandsMap[cat]) {
                brandsMap[cat].forEach(b => {
                    const opt = document.createElement('option');
                    opt.value = b;
                    opt.textContent = b;
                    if (b === selectedBrand) opt.selected = true;
                    brandSel.appendChild(opt);
                });
            }
        }
        updateBrands();
    </script>
</body>
</html>
