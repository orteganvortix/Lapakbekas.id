<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LAPAKBEKAS.ID - Jual Beli Barang Bekas Lokal</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-slate-50 text-slate-800 flex flex-col min-h-screen">

    <!-- Header tanpa logo, teks LAPAKBEKAS.ID -->
    <header class="bg-emerald-600 text-white shadow-md sticky top-0 z-50">
        <div class="max-w-5xl mx-auto px-4 py-3 flex justify-between items-center">
            <a href="/" class="text-xl font-black tracking-wider">
                LAPAK<span class="text-amber-300">BEKAS</span>.ID
            </a>
            <div class="flex items-center gap-2.5">
                <% if (user) { %>
                    <a href="/profile" class="bg-emerald-700 hover:bg-emerald-800 text-white font-semibold px-3 py-1.5 rounded-lg text-xs flex items-center gap-1.5 transition">
                        <i class="fa-solid fa-user-circle"></i> Profil
                    </a>
                    <a href="/sell" class="bg-amber-400 hover:bg-amber-500 text-slate-900 font-bold px-3 py-1.5 rounded-lg text-xs shadow transition flex items-center gap-1">
                        <i class="fa-solid fa-plus-circle"></i> Jual
                    </a>
                <% } else { %>
                    <a href="/login" class="bg-white text-emerald-700 hover:bg-emerald-50 font-bold px-3.5 py-1.5 rounded-lg text-xs shadow transition">
                        <i class="fa-solid fa-right-to-bracket"></i> Masuk
                    </a>
                <% } %>
            </div>
        </div>
    </header>

    <main class="flex-grow max-w-5xl w-full mx-auto px-4 py-6">
        
        <!-- Hero Banner & Filter Rekomendasi Daerah/Kecamatan -->
        <div class="bg-gradient-to-r from-emerald-500 to-teal-600 rounded-2xl p-6 mb-6 text-white shadow-lg">
            <h1 class="text-2xl md:text-3xl font-extrabold mb-1">Cari Barang Bekas Sekitar Anda</h1>
            <p class="text-emerald-100 text-xs md:text-sm mb-4">Rekomendasi barang layak pakai langsung dari kecamatan dan wilayah terdekat.</p>
            
            <form action="/" method="GET" class="space-y-3">
                <div class="relative">
                    <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 text-slate-400">
                        <i class="fa-solid fa-search"></i>
                    </span>
                    <input type="text" name="search" value="<%= search %>" placeholder="Cari barang (misal: Vario, HP, TV, Lemari)..." 
                        class="w-full pl-10 pr-4 py-3 rounded-xl text-slate-800 bg-white focus:outline-none focus:ring-2 focus:ring-amber-400 text-sm shadow-sm">
                </div>
                
                <div class="grid grid-cols-1 md:grid-cols-3 gap-2">
                    <select name="category" class="bg-white text-slate-800 px-3 py-2.5 rounded-xl text-xs font-medium focus:ring-2 focus:ring-amber-400">
                        <% const cats = ['Semua', 'Elektronik & Gadget', 'Kendaraan', 'Perabotan Rumah', 'Hobi & Lainnya']; %>
                        <% cats.forEach(c => { %>
                            <option value="<%= c %>" <%= selectedCategory === c ? 'selected' : '' %>><%= c %></option>
                        <% }) %>
                    </select>

                    <!-- Auto Lokasi Kecamatan / Wilayah -->
                    <div class="flex gap-1">
                        <select name="location" id="locationFilter" class="w-full bg-white text-slate-800 px-3 py-2.5 rounded-xl text-xs font-medium focus:ring-2 focus:ring-amber-400">
                            <option value="Semua">Semua Wilayah / Kecamatan</option>
                            <option value="Cisarua" <%= selectedLocation === 'Cisarua' ? 'selected' : '' %>>Kec. Cisarua</option>
                            <option value="Bandung" <%= selectedLocation === 'Bandung' ? 'selected' : '' %>>Kab/Kota Bandung</option>
                            <option value="Jakarta" <%= selectedLocation === 'Jakarta' ? 'selected' : '' %>>DKI Jakarta</option>
                            <option value="Surabaya" <%= selectedLocation === 'Surabaya' ? 'selected' : '' %>>Kota Surabaya</option>
                        </select>
                        <button type="button" onclick="autoDetectLocation()" title="Deteksi Lokasi Otomatis" class="bg-white text-emerald-700 px-3 py-2 rounded-xl text-xs font-bold shadow hover:bg-emerald-50">
                            <i class="fa-solid fa-location-crosshairs"></i>
                        </button>
                    </div>

                    <button type="submit" class="bg-slate-900 hover:bg-slate-800 text-white font-bold py-2.5 rounded-xl text-xs transition shadow flex items-center justify-center gap-2">
                        <i class="fa-solid fa-filter"></i> Terapkan Filter
                    </button>
                </div>
            </form>
        </div>

        <div class="flex justify-between items-center mb-4">
            <h2 class="text-base font-bold text-slate-800">Rekomendasi Barang Tersedia</h2>
            <span class="text-xs text-slate-500 bg-white px-3 py-1 rounded-full border shadow-sm"><%= products.length %> barang</span>
        </div>

        <% if (products.length === 0) { %>
            <div class="bg-white rounded-2xl p-12 text-center border shadow-sm">
                <i class="fa-solid fa-box-open text-4xl text-slate-300 mb-3"></i>
                <p class="text-slate-700 font-bold text-sm">Tidak ada barang di wilayah ini.</p>
                <a href="/" class="inline-block mt-4 bg-slate-900 text-white text-xs font-semibold px-4 py-2 rounded-xl">Reset Filter</a>
            </div>
        <% } else { %>
            <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
                <% products.forEach(p => { %>
                    <div class="bg-white rounded-2xl border overflow-hidden shadow-sm hover:shadow-md transition flex flex-col group">
                        <div class="h-40 bg-slate-100 relative overflow-hidden">
                            <!-- Thumbnail Cover Pertama -->
                            <img src="<%= p.images && p.images.length > 0 ? p.images[0] : p.image %>" alt="<%= p.title %>" class="w-full h-full object-cover group-hover:scale-105 transition duration-300">
                            <span class="absolute top-2 left-2 bg-slate-900/80 text-white text-[9px] font-semibold px-2 py-0.5 rounded-md">
                                <%= p.condition %>
                            </span>
                        </div>
                        <div class="p-3.5 flex flex-col flex-grow">
                            <span class="text-[10px] text-emerald-600 font-bold uppercase mb-0.5"><%= p.category %></span>
                            <h3 class="font-bold text-slate-800 text-xs line-clamp-2 mb-1"><%= p.title %></h3>
                            <p class="text-emerald-600 font-black text-sm mb-2">Rp <%= p.price.toLocaleString('id-ID') %></p>
                            
                            <div class="text-[10px] text-slate-500 flex items-center gap-1 mb-3 mt-auto">
                                <i class="fa-solid fa-location-dot text-slate-400"></i> <%= p.location %>
                            </div>
                            
                            <a href="/product/<%= p.id %>" class="w-full bg-slate-100 hover:bg-emerald-600 hover:text-white text-slate-700 text-xs font-bold py-2 rounded-xl text-center transition">
                                Lihat Detail
                            </a>
                        </div>
                    </div>
                <% }) %>
            </div>
        <% } %>
    </main>

    <!-- Footer dengan teks yang disederhanakan -->
    <footer class="bg-slate-900 text-slate-400 text-xs py-6 text-center mt-auto border-t border-slate-800">
        <p class="font-bold text-slate-300">LAPAKBEKAS.ID &copy; 2026</p>
        <p class="mt-1">Platform Jual Beli Barang Bekas Lokal</p>
    </footer>

    <script>
        function autoDetectLocation() {
            if (navigator.geolocation) {
                navigator.geolocation.getCurrentPosition(position => {
                    // Simulasi deteksi kecamatan otomatis berdasarkan koordinat GPS
                    alert("Lokasi terdeteksi! Menyesuaikan rekomendasi wilayah terdekat.");
                    document.getElementById('locationFilter').value = "Cisarua";
                }, () => {
                    alert("Gagal mendeteksi lokasi otomatis.");
                });
            }
        }
    </script>
</body>
</html>
