<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Profil Saya - LapakBekas.id</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 min-h-screen flex flex-col">
    <nav class="bg-white border-b border-gray-100 sticky top-0 z-50">
        <div class="max-w-5xl mx-auto px-4 py-3 flex justify-between items-center">
            <a href="/" class="text-xl font-black text-emerald-800">LapakBekas<span class="text-emerald-500">.id</span></a>
            <a href="/" class="text-sm font-bold text-gray-600 hover:text-emerald-700">&larr; Kembali ke Beranda</a>
        </div>
    </nav>

    <main class="max-w-5xl mx-auto px-4 py-8 flex-1 w-full space-y-8">
        <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-6 flex flex-col sm:flex-row items-center gap-6">
            <img src="<%= user.avatar %>" alt="Avatar" class="w-20 h-20 rounded-full object-cover border-2 border-emerald-500 shadow-sm">
            <div class="flex-1 text-center sm:text-left space-y-1">
                <h1 class="text-xl font-black text-gray-800"><%= user.name %></h1>
                <p class="text-sm text-gray-500"><%= user.email %></p>
                <p class="text-xs text-emerald-700 font-semibold mt-1">Terhubung via Facebook Developer</p>
            </div>
            <a href="/logout" class="bg-red-50 text-red-600 px-4 py-2 rounded-xl font-bold text-sm hover:bg-red-100 transition">Keluar</a>
        </div>

        <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-6">
            <h2 class="text-lg font-black text-gray-800 mb-6">Iklan Saya (<%= myProducts.length %>)</h2>
            <% if (myProducts.length === 0) { %>
                <div class="text-center py-12">
                    <p class="text-gray-400 text-sm mb-4">Anda belum memasang iklan barang apapun.</p>
                    <a href="/sell" class="bg-emerald-700 text-white px-4 py-2 rounded-xl font-bold text-sm hover:bg-emerald-800 transition">+ Pasang Iklan Sekarang</a>
                </div>
            <% } else { %>
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                    <% myProducts.forEach(product => { %>
                        <div class="border border-gray-100 rounded-xl p-3 flex flex-col justify-between space-y-2">
                            <img src="<%= product.image %>" alt="Foto" class="w-full h-32 object-cover rounded-lg">
                            <h3 class="font-bold text-gray-800 text-sm line-clamp-1"><%= product.title %></h3>
                            <p class="text-emerald-700 font-black text-sm">Rp <%= Number(product.price).toLocaleString('id-ID') %></p>
                            <a href="/product/<%= product.id %>" class="bg-gray-100 text-gray-700 text-center py-1.5 rounded-lg text-xs font-bold hover:bg-gray-200 transition">Lihat Iklan</a>
                        </div>
                    <% }) %>
                </div>
            <% } %>
        </div>
    </main>
</body>
</html>
