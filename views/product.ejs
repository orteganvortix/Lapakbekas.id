<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= product.title %> - LapakBekas.id</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 min-h-screen flex flex-col">
    <nav class="bg-emerald-800 text-white sticky top-0 z-50">
        <div class="max-w-md mx-auto px-4 py-3 flex justify-between items-center">
            <a href="/" class="text-lg font-black tracking-wider">LAPAKBEKAS<span class="text-emerald-400">.ID</span></a>
            <a href="/" class="text-xs font-bold text-emerald-200">&larr; Kembali</a>
        </div>
    </nav>

    <main class="max-w-md mx-auto px-4 py-6 flex-1 w-full space-y-4">
        <!-- Bagian Slider Foto -->
        <div class="bg-white rounded-3xl border border-gray-100 overflow-hidden shadow-sm relative">
            <% 
               let imgList = product.images && product.images.length > 0 ? product.images : [product.image];
            %>
            <div class="relative w-full h-64 bg-gray-900 flex items-center justify-center">
                <% imgList.forEach((img, idx) => { %>
                    <img src="<%= img %>" class="slide-img w-full h-64 object-cover <%= idx === 0 ? 'block' : 'hidden' %>" data-index="<%= idx %>">
                <% }) %>
            </div>
            <% if (imgList.length > 1) { %>
                <div class="flex justify-between items-center px-4 py-2 bg-gray-50 border-t">
                    <button onclick="prevSlide()" class="text-xs font-bold bg-emerald-700 text-white px-3 py-1 rounded-lg">&larr; Prev</button>
                    <span id="slideCounter" class="text-xs font-bold text-gray-600">1 / <%= imgList.length %></span>
                    <button onclick="nextSlide()" class="text-xs font-bold bg-emerald-700 text-white px-3 py-1 rounded-lg">Next &rarr;</button>
                </div>
            <% } %>
        </div>

        <div class="bg-white p-5 rounded-3xl border border-gray-100 shadow-sm space-y-3">
            <div class="flex justify-between items-start">
                <span class="text-[10px] font-bold text-emerald-700 bg-emerald-50 px-2.5 py-1 rounded-lg"><%= product.brand %></span>
                <span class="text-[10px] text-gray-400"><%= product.created_at %></span>
            </div>
            <h1 class="text-lg font-black text-gray-800"><%= product.title %></h1>
            <p class="text-xl font-black text-emerald-700">Rp <%= Number(product.price).toLocaleString('id-ID') %></p>
            
            <div class="grid grid-cols-2 gap-2 py-2 border-y text-xs">
                <div>
                    <span class="text-gray-400 block text-[10px]">Kondisi</span>
                    <span class="font-bold text-gray-800"><%= product.condition %> (<%= product.damage_percent %>)</span>
                </div>
                <div>
                    <span class="text-gray-400 block text-[10px]">Lokasi</span>
                    <span class="font-bold text-gray-800"><%= product.location %></span>
                </div>
            </div>

            <div>
                <h3 class="text-xs font-bold text-gray-700 mb-1">Deskripsi</h3>
                <p class="text-xs text-gray-600 whitespace-pre-line"><%= product.description || 'Tidak ada deskripsi.' %></p>
            </div>
        </div>

        <div class="bg-white p-5 rounded-3xl border border-gray-100 shadow-sm space-y-3">
            <h3 class="text-xs font-bold text-gray-700">Penjual</h3>
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-full bg-emerald-100 flex items-center justify-center font-bold text-emerald-800 text-xs">
                    <%= product.seller_name ? product.seller_name.charAt(0) : 'P' %>
                </div>
                <div>
                    <h4 class="font-bold text-gray-800 text-xs"><%= product.seller_name %></h4>
                    <span class="text-[10px] text-gray-400">Terverifikasi</span>
                </div>
            </div>
            <% if (product.whatsapp) { %>
                <a href="https://wa.me/<%= product.whatsapp.replace(/[^0-9]/g, '') %>?text=Halo%20saya%20tertarik%20dengan%20<%= encodeURIComponent(product.title) %>" target="_blank" class="block w-full bg-emerald-600 text-white font-bold text-center py-3 rounded-xl hover:bg-emerald-700 transition text-xs shadow-md">Hubungi WhatsApp Penjual</a>
            <% } %>
        </div>
    </main>

    <script>
        let currentIdx = 0;
        const images = document.querySelectorAll('.slide-img');
        const counter = document.getElementById('slideCounter');

        function showSlide(idx) {
            images.forEach((img, i) => {
                img.classList.toggle('hidden', i !== idx);
                img.classList.toggle('block', i === idx);
            });
            if (counter) counter.innerText = `${idx + 1} / ${images.length}`;
        }

        function nextSlide() {
            currentIdx = (currentIdx + 1) % images.length;
            showSlide(currentIdx);
        }

        function prevSlide() {
            currentIdx = (currentIdx - 1 + images.length) % images.length;
            showSlide(currentIdx);
        }
    </script>
</body>
</html>
