<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= product.title %> - LapakBekas.id</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 min-h-screen flex flex-col">
    <nav class="bg-white border-b border-gray-100 sticky top-0 z-50">
        <div class="max-w-5xl mx-auto px-4 py-3 flex justify-between items-center">
            <a href="/" class="text-xl font-black text-emerald-800">LapakBekas<span class="text-emerald-500">.id</span></a>
            <a href="/" class="text-sm font-bold text-gray-600 hover:text-emerald-700">&larr; Kembali ke Beranda</a>
        </div>
    </nav>

    <main class="max-w-5xl mx-auto px-4 py-8 flex-1 w-full grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="bg-white p-4 rounded-2xl border border-gray-100 shadow-sm h-fit">
            <img src="<%= product.image %>" alt="<%= product.title %>" class="w-full h-80 object-cover rounded-xl">
        </div>

        <div class="space-y-6">
            <div class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm space-y-4">
                <div class="flex justify-between items-start">
                    <span class="text-xs font-bold text-emerald-700 bg-emerald-50 px-3 py-1 rounded-lg"><%= product.category %> / <%= product.brand %></span>
                    <span class="text-xs font-semibold text-gray-500"><%= product.created_at %></span>
                </div>
                <h1 class="text-2xl font-black text-gray-800"><%= product.title %></h1>
                <p class="text-2xl font-black text-emerald-700">Rp <%= Number(product.price).toLocaleString('id-ID') %></p>
                
                <div class="grid grid-cols-2 gap-4 py-3 border-y border-gray-100 text-sm">
                    <div>
                        <span class="text-gray-400 block text-xs">Kondisi</span>
                        <span class="font-bold text-gray-800"><%= product.condition %> (<%= product.damage_percent %>)</span>
                    </div>
                    <div>
                        <span class="text-gray-400 block text-xs">Lokasi</span>
                        <span class="font-bold text-gray-800"><%= product.location %></span>
                    </div>
                </div>

                <div>
                    <h3 class="text-sm font-bold text-gray-700 mb-1">Deskripsi</h3>
                    <p class="text-sm text-gray-600 whitespace-pre-line leading-relaxed"><%= product.description || 'Tidak ada deskripsi.' %></p>
                </div>
            </div>

            <div class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm space-y-4">
                <h3 class="text-sm font-bold text-gray-700">Informasi Penjual</h3>
                <div class="flex items-center gap-3">
                    <img src="<%= seller.avatar || 'https://images.unsplash.com/photo-1522075469751-3a6694fb2f65' %>" alt="Penjual" class="w-12 h-12 rounded-full object-cover">
                    <div>
                        <h4 class="font-bold text-gray-800 text-sm"><%= seller.name %></h4>
                        <span class="text-xs text-gray-400"><%= seller.email %></span>
                    </div>
                </div>
                <% if (seller.phone) { %>
                    <a href="https://wa.me/<%= seller.phone.replace(/[^0-9]/g, '') %>" target="_blank" class="block w-full bg-emerald-700 text-white font-bold text-center py-3 rounded-xl hover:bg-emerald-800 transition text-sm shadow-md">Hubungi via WhatsApp</a>
                <% } else { %>
                    <p class="text-xs text-gray-400 text-center py-2">Penjual tidak menyertakan nomor telepon.</p>
                <% } %>
            </div>
        </div>
    </main>
</body>
</html>
