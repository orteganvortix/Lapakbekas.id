<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login Resmi - LapakBekas.id</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Identity Services SDK -->
    <script src="https://accounts.google.com/gsi/client" async defer></script>
</head>
<body class="bg-gray-50 min-h-screen flex items-center justify-center px-4">
    <div class="max-w-md w-full bg-white rounded-3xl shadow-lg p-8 border border-gray-100 text-center space-y-6">
        <div class="space-y-2">
            <h1 class="text-2xl font-black text-emerald-900">LapakBekas.id</h1>
            <p class="text-xs text-gray-500">Silakan masuk menggunakan akun Gmail asli Anda untuk melanjutkan.</p>
        </div>

        <!-- Tombol Resmi Google Login -->
        <div class="flex justify-center py-4">
            <div id="g_id_onload"
                 data-client_id="762977507378-mns48geiscvqu0rpqdpb6ltnqsa6rk22.apps.googleusercontent.com"
                 data-callback="handleCredentialResponse"
                 data-auto_prompt="false">
            </div>
            <div class="g_id_signin"
                 data-type="standard"
                 data-size="large"
                 data-theme="outline"
                 data-text="sign_in_with"
                 data-shape="rectangular"
                 data-logo_alignment="left">
            </div>
        </div>

        <p class="text-[10px] text-gray-400">Dengan masuk, Anda menyetujui verifikasi keamanan berbasis akun Google asli.</p>
    </div>

    <form id="authForm" action="/auth/google/callback" method="POST" class="hidden">
        <input type="hidden" name="credential" id="credentialInput">
    </form>

    <script>
        function handleCredentialResponse(response) {
            // Kirim token JWT Google ke server untuk diverifikasi keasliannya
            document.getElementById('credentialInput').value = response.credential;
            document.getElementById('authForm').submit();
        }
    </script>
</body>
</html>

