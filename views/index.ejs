<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LapakBekas.id</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 min-h-screen flex flex-col">
    <!-- Navbar -->
    <nav class="bg-emerald-800 text-white sticky top-0 z-50 shadow-sm">
        <div class="max-w-md mx-auto px-4 py-3 flex justify-between items-center">
            <a href="/" class="text-lg font-black tracking-wider">LAPAKBEKAS<span class="text-emerald-400">.ID</span></a>
            <div class="flex items-center gap-2">
                <% if (user) { %>
                    <a href="/profile" class="bg-emerald-700 hover:bg-emerald-600 text-white px-3 py-1.5 rounded-xl font-bold text-xs flex items-center gap-1.5 transition">
                        <span>&#128100; Profil</span>
                    </a>
                <% } else { %>
                    <a href="/login" class="bg-emerald-700 hover:bg-emerald-600 text-white px-3 py-1.5 rounded-xl font-bold text-xs transition">Masuk</a>
                <% } %>
                <a href="/sell" class="bg-amber-400 hover:bg-amber-500 text-emerald-950 px-3 py-1.5 rounded-xl font-black text-xs flex items-center gap-1 shadow-sm transition">
                    <span>&#43; Jual</span>
                </a>
            </div>
        </div>
    </nav>

    <!-- Header & Filter Section -->
    <div class="bg-emerald-800 px-4 pt-4 pb-6">
        <div class="max-w-md mx-auto">
            <div class="bg-gradient-to-br from-emerald-500 to-emerald-700 rounded-3xl p-5 text-white shadow-lg space-y-4">
                <div class="space-y-1">
                    <h1 class="text-xl font-black tracking-tight">Cari Barang Bekas Sekitar Anda</h1>
                    <p class="text-xs text-emerald-100 leading-relaxed">Rekomendasi barang layak pakai langsung dari kecamatan dan wilayah terdekat.</p>
                </div>

                <form action="/" method="GET" class="space-y-3">
                    <!-- Input Pencarian -->
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 pointer-events-none text-gray-400">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                        </span>
                        <input type="text" name="search" value="<%= search %>" placeholder="Cari barang (misal: Vario, HP, TV, Lemari)..." class="w-full bg-white text-gray-800 placeholder-gray-400 text-xs rounded-xl pl-10 pr-4 py-3 font-medium focus:outline-none focus:ring-2 focus:ring-emerald-400 shadow-sm">
                    </div>

                    <!-- Pilihan Kategori -->
                    <div class="relative">
                        <select name="category" class="w-full bg-white text-gray-800 text-xs rounded-xl px-4 py-3 font-medium focus:outline-none focus:ring-2 focus:ring-emerald-400 shadow-sm appearance-none">
                            <option value="Semua" <%= selectedCategory === 'Semua' ? 'selected' : '' %>>Semua</option>
                            <option value="Elektronik & Gadget" <%= selectedCategory === 'Elektronik & Gadget' ? 'selected' : '' %>>Elektronik & Gadget</option>
                            <option value="Kendaraan" <%= selectedCategory === 'Kendaraan' ? 'selected' : '' %>>Kendaraan</option>
                            <option value="Perabotan Rumah" <%= selectedCategory === 'Perabotan Rumah' ? 'selected' : '' %>>Perabotan Rumah</option>
                            <option value="Hobi & Lainnya" <%= selectedCategory === 'Hobi & Lainnya' ? 'selected' : '' %>>Hobi & Lainnya</option>
                        </select>
                        <div class="absolute inset-y-0 right-0 flex items-center px-3 pointer-events-none text-gray-500">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path></svg>
                        </div>
                    </div>

                    <!-- Pilihan Wilayah & Tombol Target -->
                    <div class="flex gap-2">
                        <div class="relative flex-1">
                            <select name="location" class="w-full bg-white text-gray-800 text-xs rounded-xl px-4 py-3 font-medium focus:outline-none focus:ring-2 focus:ring-emerald-400 shadow-sm appearance-none">
                                <option value="Semua" <%= selectedLocation === 'Semua' ? 'selected' : '' %>>Semua Wilayah / Kecamatan</option>
                                <% locations.forEach(loc => { %>
                                    <option value="<%= loc %>" <%= selectedLocation === loc ? 'selected' : '' %>><%= loc %></option>
                                <% }) %>
                            </select>
                            <div class="absolute inset-y-0 right-0 flex items-center px-3 pointer-events-none text-gray-500">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path></svg>
                            </div>
                        </div>
                        <button type="button" onclick="alert('Fitur deteksi lokasi GPS aktif')" class="bg-white hover:bg-gray-100 text-emerald-800 p-3 rounded-xl flex items-center justify-center shadow-sm transition">
                            <svg class="w-4 h-4 text-emerald-700" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"></circle><path stroke-linecap="round" stroke-linejoin="round" d="M12 2v3m0 14v3M2 12h3m14 0h3"></path></svg>
                        </button>
                    </div>

                    <!-- Tombol Terapkkan Filter -->
                    <button type="submit" class="w-full bg-[#0d1b2a] hover:bg-[#1b263b] text-white font-bold py-3 rounded-xl text-xs transition shadow-md flex items-center justify-center gap-2">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon></svg>
                        Terapkan Filter
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- Daftar Produk / Kosong -->
    <main class="max-w-md mx-auto px-4 py-6 flex-1 w-full space-y-4">
        <div class="flex justify-between items-center">
            <h2 class="text-xs font-black uppercase tracking-wider text-gray-700">Rekomendasi Barang Tersedia</h2>
            <span class="bg-gray-200 text-gray-700 text-[10px] font-bold px-2 py-0.5 rounded-full"><%= products.length %> barang</span>
        </div>

        <% if (products.length === 0) { %>
            <div class="bg-white rounded-3xl border border-gray-100 p-8 text-center shadow-sm space-y-4">
                <div class="w-16 h-16 bg-gray-100 rounded-2xl mx-auto flex items-center justify-center text-gray-400">
                    <svg class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path></svg>
                </div>
                <p class="text-xs font-bold text-gray-600">Tidak ada barang di wilayah ini.</p>
                <a href="/" class="inline-block bg-[#0d1b2a] text-white font-bold px-6 py-2.5 rounded-xl text-xs hover:bg-[#1b263b] transition shadow-sm">Reset Filter</a>
            </div>
        <% } else { %>
            <div class="grid grid-cols-2 gap-3">
                <% products.forEach(product => { %>
                    <a href="/product/<%= product.id %>" class="bg-white rounded-2xl border border-gray-100 overflow-hidden shadow-sm hover:shadow-md transition flex flex-col">
                        <img src="<%= product.image %>" alt="<%= product.title %>" class="w-full h-36 object-cover">
                        <div class="p-3 flex flex-col flex-1 justify-between space-y-2">
                            <div>
                                <span class="text-[9px] font-bold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-md"><%= product.brand %></span>
                                <h3 class="font-bold text-gray-800 text-xs mt-1.5 line-clamp-2"><%= product.title %></h3>
                            </div>
                            <div>
                                <p class="text-emerald-700 font-black text-xs">Rp <%= Number(product.price).toLocaleString('id-ID') %></p>
                                <span class="text-[10px] text-gray-400 block truncate mt-1"><%= product.location %></span>
                            </div>
                        </div>
                    </a>
                <% }) %>
            </div>
        <% } %>
    </main>

    <footer class="bg-white border-t border-gray-100 py-4 text-center text-[10px] text-gray-400">
        LAPAKBEKAS.ID &copy; 2026
    </footer>
</body>
</html>

