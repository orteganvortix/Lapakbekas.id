<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pasang Iklan - LapakBekas.id</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 min-h-screen">
    <div class="max-w-md mx-auto py-8 px-4">
        <div class="bg-white rounded-3xl shadow-md p-6 border border-gray-100 space-y-6">
            <div class="flex justify-between items-center">
                <h1 class="text-xl font-black text-emerald-900">Pasang Iklan Baru</h1>
                <a href="/profile" class="text-xs font-bold text-gray-500 hover:text-gray-800">Kembali</a>
            </div>

            <form action="/sell" method="POST" class="space-y-4">
                <div>
                    <label class="block text-gray-700 font-bold text-xs mb-1">Barang yang Dijual *</label>
                    <input type="text" name="title" required placeholder="Contoh: Honda Vario 150 CBS ISS" class="w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-2.5 text-xs focus:outline-none">
                </div>

                <div>
                    <label class="block text-gray-700 font-bold text-xs mb-1">Harga (Rp) *</label>
                    <input type="text" id="priceInput" name="price" required placeholder="Contoh: 15.000.000" oninput="formatPrice(this)" class="w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-2.5 text-xs focus:outline-none">
                </div>

                <div>
                    <label class="block text-gray-700 font-bold text-xs mb-1">Nomor WhatsApp Aktif *</label>
                    <div class="flex items-center bg-gray-50 border border-gray-200 rounded-xl overflow-hidden">
                        <span class="bg-gray-200 text-gray-700 font-bold px-3 py-2.5 text-xs border-r border-gray-200">+62</span>
                        <input type="tel" name="whatsapp" required placeholder="81234567890" value="<%= user.phone ? user.phone.replace('+62', '').replace(/^0/, '') : '' %>" class="w-full bg-transparent px-3 py-2.5 text-xs focus:outline-none">
                    </div>
                </div>

                <div>
                    <label class="block text-gray-700 font-bold text-xs mb-1">Kategori *</label>
                    <select name="category" id="categorySelect" onchange="updateBrands()" class="w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-2.5 text-xs focus:outline-none">
                        <% Object.keys(brandsMap).forEach(cat => { %>
                            <option value="<%= cat %>"><%= cat %></option>
                        <% }) %>
                    </select>
                </div>

                <div>
                    <label class="block text-gray-700 font-bold text-xs mb-1">Merk / Type *</label>
                    <select name="brand" id="brandSelect" required class="w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-2.5 text-xs focus:outline-none"></select>
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-gray-700 font-bold text-xs mb-1">Kondisi *</label>
                        <select name="condition" id="conditionSelect" onchange="toggleDamage()" class="w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-2.5 text-xs focus:outline-none">
                            <option value="Bekas">Bekas</option>
                            <option value="Baru">Baru</option>
                        </select>
                    </div>
                    <div id="damageContainer">
                        <label class="block text-gray-700 font-bold text-xs mb-1">Tingkat Mulus *</label>
                        <select name="damage_percent" class="w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-2.5 text-xs focus:outline-none">
                            <option value="100%">100% (Sempurna)</option>
                            <option value="90%">90% (Sangat Mulus)</option>
                            <option value="70%">70% (Mulus Normal)</option>
                            <option value="50%">50% (Layak Pakai)</option>
                        </select>
                    </div>
                </div>

                <!-- PENGISIAN LOKASI RESMI (BERTINGKAT PROVINSI, KAB/KOTA, KECAMATAN) -->
                <div class="bg-gray-50 p-4 rounded-2xl border border-gray-200 space-y-3">
                    <label class="block text-emerald-900 font-black text-xs">Pilih Wilayah Resmi Indonesia *</label>
                    
                    <div>
                        <span class="text-[10px] font-bold text-gray-600 block mb-1">1. Provinsi</span>
                        <select id="provinsiSelect" onchange="loadKabupaten()" class="w-full bg-white border border-gray-200 rounded-xl px-3 py-2 text-xs focus:outline-none">
                            <option value="">-- Pilih Provinsi --</option>
                        </select>
                    </div>

                    <div>
                        <span class="text-[10px] font-bold text-gray-600 block mb-1">2. Kabupaten / Kota</span>
                        <select id="kabupatenSelect" onchange="loadKecamatan()" disabled class="w-full bg-white border border-gray-200 rounded-xl px-3 py-2 text-xs focus:outline-none disabled:bg-gray-100">
                            <option value="">-- Pilih Kabupaten / Kota --</option>
                        </select>
                    </div>

                    <div>
                        <span class="text-[10px] font-bold text-gray-600 block mb-1">3. Kecamatan</span>
                        <select id="kecamatanSelect" onchange="setFinalLocation()" disabled class="w-full bg-white border border-gray-200 rounded-xl px-3 py-2 text-xs focus:outline-none disabled:bg-gray-100">
                            <option value="">-- Pilih Kecamatan --</option>
                        </select>
                    </div>

                    <!-- Input Hidden Lokasi Final yang tersimpan ke Database -->
                    <input type="hidden" id="locationFinal" name="location" required>
                    <p class="text-[11px] text-emerald-700 font-bold mt-1" id="selectedLocationText">Lokasi terpilih: Belum dipilih</p>
                </div>

                <!-- TITIK KOORDINAT MANUAL ATAU OTOMATIS GPS -->
                <div class="bg-gray-50 p-4 rounded-2xl border border-gray-200 space-y-3">
                    <div class="flex justify-between items-center">
                        <label class="block text-emerald-900 font-black text-xs">Titik Koordinat (Opsional / Manual)</label>
                        <button type="button" onclick="getGPSLocation()" class="bg-emerald-100 text-emerald-800 font-bold px-2 py-1 rounded-lg text-[10px] hover:bg-emerald-200 transition">Gunakan GPS Saya</button>
                    </div>
                    <div class="grid grid-cols-2 gap-2">
                        <div>
                            <span class="text-[10px] font-bold text-gray-600 block mb-1">Latitude</span>
                            <input type="text" id="latInput" name="lat" placeholder="-6.6912" class="w-full bg-white border border-gray-200 rounded-xl px-3 py-2 text-xs focus:outline-none">
                        </div>
                        <div>
                            <span class="text-[10px] font-bold text-gray-600 block mb-1">Longitude</span>
                            <input type="text" id="lonInput" name="lon" placeholder="106.9421" class="w-full bg-white border border-gray-200 rounded-xl px-3 py-2 text-xs focus:outline-none">
                        </div>
                    </div>
                </div>

                <div>
                    <label class="block text-gray-700 font-bold text-xs mb-1">Upload Foto / Gambar (Maksimal 10 Foto) *</label>
                    <input type="file" id="imageInput" accept="image/*" multiple onchange="handleFiles(this)" class="w-full bg-gray-50 border border-gray-200 rounded-xl px-3 py-2 text-xs file:mr-2 file:py-1 file:px-3 file:rounded-lg file:bg-emerald-50 file:text-emerald-700">
                    <div id="previewContainer" class="grid grid-cols-5 gap-2 mt-2"></div>
                </div>

                <div>
                    <label class="block text-gray-700 font-bold text-xs mb-1">Deskripsi Lengkap</label>
                    <textarea name="description" rows="3" placeholder="Jelaskan spesifikasi dan kelengkapan..." class="w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-2.5 text-xs focus:outline-none"></textarea>
                </div>

                <button type="submit" class="w-full bg-emerald-700 text-white font-bold py-3 rounded-xl hover:bg-emerald-800 transition text-xs shadow-md">Terbitkan Iklan</button>
            </form>
        </div>
    </div>

    <script>
        const brandsMap = <%- JSON.stringify(brandsMap) %>;

        function updateBrands() {
            const cat = document.getElementById('categorySelect').value;
            const brandSel = document.getElementById('brandSelect');
            brandSel.innerHTML = '';
            if (brandsMap[cat]) {
                brandsMap[cat].forEach(b => {
                    const opt = document.createElement('option');
                    opt.value = b; opt.textContent = b;
                    brandSel.appendChild(opt);
                });
            }
        }
        updateBrands();

        function toggleDamage() {
            const cond = document.getElementById('conditionSelect').value;
            document.getElementById('damageContainer').style.display = cond === 'Baru' ? 'none' : 'block';
        }

        function formatPrice(input) {
            let value = input.value.replace(/[^0-9]/g, '');
            if (value) {
                value = Number(value).toLocaleString('id-ID');
            }
            input.value = value;
        }

        // INTEGRASI API RESMI WILAYAH INDONESIA (EMSifa / Kemendagri Public API)
        const API_BASE = "https://emsifa.github.io/api-wilayah-indonesia/api";

        async function loadProvinsi() {
            try {
                const res = await fetch(`${API_BASE}/provinces.json`);
                const provinces = await res.json();
                const sel = document.getElementById('provinsiSelect');
                provinces.forEach(p => {
                    const opt = document.createElement('option');
                    opt.value = p.id;
                    opt.textContent = p.name;
                    sel.appendChild(opt);
                });
            } catch (e) {
                console.error("Gagal memuat data provinsi resmi");
            }
        }
        loadProvinsi();

        async function loadKabupaten() {
            const provId = document.getElementById('provinsiSelect').value;
            const kabSel = document.getElementById('kabupatenSelect');
            const kecSel = document.getElementById('kecamatanSelect');
            
            kabSel.innerHTML = '<option value="">-- Pilih Kabupaten / Kota --</option>';
            kecSel.innerHTML = '<option value="">-- Pilih Kecamatan --</option>';
            kabSel.disabled = !provId;
            kecSel.disabled = true;

            if (!provId) return;

            try {
                const res = await fetch(`${API_BASE}/regencies/${provId}.json`);
                const regencies = await res.json();
                regencies.forEach(r => {
                    const opt = document.createElement('option');
                    opt.value = r.id;
                    opt.textContent = r.name;
                    kabSel.appendChild(opt);
                });
            } catch (e) {}
            setFinalLocation();
        }

        async function loadKecamatan() {
            const kabId = document.getElementById('kabupatenSelect').value;
            const kecSel = document.getElementById('kecamatanSelect');
            
            kecSel.innerHTML = '<option value="">-- Pilih Kecamatan --</option>';
            kecSel.disabled = !kabId;

            if (!kabId) return;

            try {
                const res = await fetch(`${API_BASE}/districts/${kabId}.json`);
                const districts = await res.json();
                districts.forEach(d => {
                    const opt = document.createElement('option');
                    opt.value = d.id;
                    opt.textContent = d.name;
                    kecSel.appendChild(opt);
                });
            } catch (e) {}
            setFinalLocation();
        }

        function setFinalLocation() {
            const provOpt = document.getElementById('provinsiSelect').selectedOptions[0];
            const kabOpt = document.getElementById('kabupatenSelect').selectedOptions[0];
            const kecOpt = document.getElementById('kecamatanSelect').selectedOptions[0];

            let parts = [];
            if (kecOpt && kecOpt.value) parts.push(kecOpt.textContent);
            if (kabOpt && kabOpt.value) parts.push(kabOpt.textContent);
            if (provOpt && provOpt.value) parts.push(provOpt.textContent);

            const resultStr = parts.join(', ');
            document.getElementById('locationFinal').value = resultStr;
            document.getElementById('selectedLocationText').textContent = "Lokasi terpilih: " + (resultStr || "Belum dipilih");
        }

        function getGPSLocation() {
            if (navigator.geolocation) {
                navigator.geolocation.getCurrentPosition(
                    (pos) => {
                        document.getElementById('latInput').value = pos.coords.latitude;
                        document.getElementById('lonInput').value = pos.coords.longitude;
                        alert("Titik koordinat GPS berhasil dimuat!");
                    },
                    (err) => {
                        alert("Gagal mendeteksi GPS. Silakan isi koordinat secara manual.");
                    }
                );
            } else {
                alert("Geolocation tidak didukung oleh browser Anda.");
            }
        }

        function handleFiles(input) {
            const container = document.getElementById('previewContainer');
            container.innerHTML = '';
            const files = Array.from(input.files).slice(0, 10);
            
            files.forEach(file => {
                const reader = new FileReader();
                reader.onload = function(e) {
                    const div = document.createElement('div');
                    div.className = 'relative w-full h-16';
                    div.innerHTML = `<img src="${e.target.result}" class="w-full h-full object-cover rounded-lg border">
                                     <input type="hidden" name="images" value="${e.target.result}">`;
                    container.appendChild(div);
                }
                reader.readAsDataURL(file);
            });
        }
    </script>
</body>
</html>
