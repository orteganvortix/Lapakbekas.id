<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LapakBekas.id - Jual Beli Barang Bekas Terpercaya</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 min-h-screen flex flex-col">
    <!-- Navbar -->
    <nav class="bg-white border-b border-gray-100 sticky top-0 z-50">
        <div class="max-w-6xl mx-auto px-4 py-3 flex justify-between items-center">
            <a href="/" class="text-xl font-black text-emerald-800">LapakBekas<span class="text-emerald-500">.id</span></a>
            <div class="flex items-center gap-3">
                <a href="/sell" class="bg-emerald-700 text-white px-4 py-2 rounded-xl font-bold text-sm hover:bg-emerald-800 transition">+ Pasang Iklan</a>
                <% if (user) { %>
                    <a href="/profile" class="flex items-center gap-2 bg-gray-100 px-3 py-1.5 rounded-xl hover:bg-gray-200 transition">
                        <img src="<%= user.avatar %>" alt="Profil" class="w-7 h-7 rounded-full object-cover">
                        <span class="text-sm font-semibold text-gray-700 hidden sm:inline"><%= user.name %></span>
                    </a>
                <% } else { %>
                    <a href="/login" class="bg-gray-100 text-gray-700 px-4 py-2 rounded-xl font-bold text-sm hover:bg-gray-200 transition">Masuk / Daftar</a>
                <% } %>
            </div>
        </div>
    </nav>

    <!-- Header & Filter -->
    <div class="bg-emerald-900 text-white py-10 px-4">
        <div class="max-w-6xl mx-auto space-y-6">
            <div class="text-center space-y-2">
                <h1 class="text-3xl font-black">Cari Barang Bekas Berkualitas</h1>
                <p class="text-emerald-200 text-sm">Platform jual beli barang bekas terpercaya di sekitarmu.</p>
            </div>
            
            <form action="/" method="GET" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-5 gap-3 bg-white p-3 rounded-2xl shadow-lg">
                <input type="text" name="search" value="<%= search %>" placeholder="Cari barang atau merk..." class="bg-gray-50 border border-gray-200 rounded-xl px-4 py-2 text-sm text-gray-800 focus:outline-none focus:ring-2 focus:ring-emerald-500">
                
                <select name="category" onchange="this.form.submit()" class="bg-gray-50 border border-gray-200 rounded-xl px-4 py-2 text-sm text-gray-800 focus:outline-none focus:ring-2 focus:ring-emerald-500">
                    <option value="Semua" <%= selectedCategory === 'Semua' ? 'selected' : '' %>>Semua Kategori</option>
                    <option value="Elektronik & Gadget" <%= selectedCategory === 'Elektronik & Gadget' ? 'selected' : '' %>>Elektronik & Gadget</option>
                    <option value="Kendaraan" <%= selectedCategory === 'Kendaraan' ? 'selected' : '' %>>Kendaraan</option>
                    <option value="Perabotan Rumah" <%= selectedCategory === 'Perabotan Rumah' ? 'selected' : '' %>>Perabotan Rumah</option>
                    <option value="Hobi & Lainnya" <%= selectedCategory === 'Hobi & Lainnya' ? 'selected' : '' %>>Hobi & Lainnya</option>
                </select>

                <select name="condition" onchange="this.form.submit()" class="bg-gray-50 border border-gray-200 rounded-xl px-4 py-2 text-sm text-gray-800 focus:outline-none focus:ring-2 focus:ring-emerald-500">
                    <option value="Semua" <%= selectedCondition === 'Semua' ? 'selected' : '' %>>Semua Kondisi</option>
                    <option value="Bekas" <%= selectedCondition === 'Bekas' ? 'selected' : '' %>>Bekas</option>
                    <option value="Baru" <%= selectedCondition === 'Baru' ? 'selected' : '' %>>Baru</option>
                </select>

                <select name="location" onchange="this.form.submit()" class="bg-gray-50 border border-gray-200 rounded-xl px-4 py-2 text-sm text-gray-800 focus:outline-none focus:ring-2 focus:ring-emerald-500">
                    <option value="Semua" <%= selectedLocation === 'Semua' ? 'selected' : '' %>>Semua Lokasi</option>
                    <% locations.forEach(loc => { %>
                        <option value="<%= loc %>" <%= selectedLocation === loc ? 'selected' : '' %>><%= loc %></option>
                    <% }) %>
                </select>

                <button type="submit" class="bg-emerald-700 text-white font-bold py-2 rounded-xl text-sm hover:bg-emerald-800 transition shadow-sm">Filter</button>
            </form>
        </div>
    </div>

    <!-- Produk Grid -->
    <main class="max-w-6xl mx-auto px-4 py-8 flex-1 w-full">
        <h2 class="text-xl font-black text-gray-800 mb-6">Iklan Terbaru</h2>
        <% if (products.length === 0) { %>
            <div class="text-center py-16 bg-white rounded-2xl border border-gray-100">
                <p class="text-gray-500 font-medium">Belum ada iklan barang yang ditemukan.</p>
            </div>
        <% } else { %>
            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-6">
                <% products.forEach(product => { %>
                    <a href="/product/<%= product.id %>" class="bg-white rounded-2xl border border-gray-100 overflow-hidden shadow-sm hover:shadow-md transition flex flex-col">
                        <img src="<%= product.image %>" alt="<%= product.title %>" class="w-full h-48 object-cover">
                        <div class="p-4 flex flex-col flex-1 justify-between space-y-3">
                            <div>
                                <span class="text-xs font-bold text-emerald-700 bg-emerald-50 px-2.5 py-1 rounded-lg"><%= product.brand %></span>
                                <h3 class="font-bold text-gray-800 text-sm mt-2 line-clamp-2"><%= product.title %></h3>
                            </div>
                            <div>
                                <p class="text-emerald-700 font-black text-base">Rp <%= Number(product.price).toLocaleString('id-ID') %></p>
                                <div class="flex justify-between items-center text-xs text-gray-400 mt-2">
                                    <span class="truncate max-w-[120px]"><%= product.location %></span>
                                    <span><%= product.created_at %></span>
                                </div>
                            </div>
                        </div>
                    </a>
                <% }) %>
            </div>
        <% } %>
    </main>

    <footer class="bg-white border-t border-gray-100 py-6 text-center text-xs text-gray-400">
        &copy; 2026 LapakBekas.id - Seluruh Hak Cipta Dilindungi.
    </footer>
</body>
</html>
